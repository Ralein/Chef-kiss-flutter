<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen: the app icon's cream disc on the app's canvas, where
     the app's own splash (SplashView) then carries on. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item
        android:width="144dp"
        android:height="144dp"
        android:gravity="center"
        android:drawable="@drawable/splash_medallion" />
</layer-list>
