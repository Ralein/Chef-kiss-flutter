<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP only to this device's own loopback address: an AI gateway on the
     user's computer, reached over USB with `adb reverse tcp:18899 tcp:18899`.
     Every other connection stays HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
